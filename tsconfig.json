{
  "compilerOptions": {
    "preserveConstEnums": true,
    "strictNullChecks": true,
    "sourceMap": true,
    "allowJs": true,
    "target": "es2022",
    "outDir": ".build",
    "module": "commonjs",
    "lib": ["es2022"],
    "rootDir": "./",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "typeRoots": ["./node_modules/@types", "./types/"]
  }
}
